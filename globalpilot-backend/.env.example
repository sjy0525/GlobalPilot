# 复制为本目录的 .env，再替换 replace-with- 开头的占位值。
# 后端从当前目录的 .env 读取配置，启动时请位于 globalpilot-backend。

# 本地 PostgreSQL（对应 docker-compose.yml 中的用户、数据库名和映射端口）。
# Compose 读取 POSTGRES_PASSWORD；后端读取 DATABASE_URL。
# 两处密码须一致。密码有 URL 保留字符时，仅在 DATABASE_URL 中做百分号编码。
POSTGRES_PASSWORD=replace-with-local-postgres-password
DATABASE_URL=postgresql+psycopg://sjy:replace-with-local-postgres-password@127.0.0.1:5434/globalpilot

# 使用随机字符串签发 JWT，例如用 python3 -c 'import secrets; print(secrets.token_urlsafe(48))' 生成。
JWT_SECRET_KEY=replace-with-generated-jwt-secret
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# REFRESH_TOKEN_EXPIRE_DAYS=14
# HTTPS 部署请设为 true。本地 HTTP 使用 false。
# REFRESH_COOKIE_SECURE=false
# AUTH_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 从阿里云百炼获取 Embedding 和 Rerank 所需的 API Key。跨区域部署时使用对应区域的兼容接口地址。
DASHSCOPE_API_KEY=replace-with-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_RERANK_API_KEY=replace-with-dashscope-rerank-api-key
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# DASHSCOPE_EMBEDDING_DIMENSIONS=1024
# DASHSCOPE_RERANK_MODEL=qwen3-rerank
# DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1

# 从 DeepSeek 开放平台获取 API Key。
DEEPSEEK_API_KEY=replace-with-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# 营销调研需要联网搜索时，填入百度智能云千帆的 API Key。
BAIDU_SEARCH_API_KEY=
# BAIDU_SEARCH_URL=https://qianfan.baidubce.com/v2/ai_search/web_search

# 需要自定义 Google 登录时，填写 Google Cloud Web OAuth 客户端 ID，并与前端保持一致。
# GOOGLE_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com

# 知识库检索可选覆盖项，以下为后端默认值。
# RAG_RETRIEVAL_MODE=hybrid
# RAG_CHUNK_SIZE=500
# RAG_CHUNK_OVERLAP=80
# RAG_RECALL_K=10
# RAG_SEARCH_K=3
# RAG_FETCH_K=20
# RAG_MAX_DISTANCE=0.64
# RAG_KEYWORD_FETCH_K=20
# RAG_FUSION_K=20
# RAG_RRF_CONSTANT=60
